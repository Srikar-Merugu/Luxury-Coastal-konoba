# Copy to .env.local (and add the same keys in Vercel → Settings → Environment Variables).
# Without these the site still runs on the built-in content in lib/content.ts.

# Supabase (Project Settings → API). The anon key is public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gmail sending (works for any recipient, no domain needed). SMTP_PASS is a Google
# app password (myaccount.google.com/apppasswords, needs 2-Step Verification).
# When set, Gmail is used instead of Resend.
SMTP_USER=
SMTP_PASS=

# Resend (resend.com → API Keys). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Konoba Plavi Kamen <stol@konoba.demo.kyrostudio.eu>"
# Kyro test inbox that plays the owner: gets every new request.
BOOKING_INBOX=

# Public site URL, used in owner emails.
NEXT_PUBLIC_SITE_URL=https://konoba.demo.kyrostudio.eu

# AI concierge ("Ask us" chat). Set any of these; free ones are tried first,
# and the next is used if one fails. Without any key the chat button is hidden.
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Anthropic (paid, prepaid credit)
ANTHROPIC_API_KEY=

# WhatsApp number guests message (digits with country code). Defaults to the venue phone.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# GA4 measurement ID (G-XXXXXXX). Vercel Analytics needs no key: enable it in the Vercel project.
NEXT_PUBLIC_GA_ID=
